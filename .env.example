# Copy to .env and fill in for production MySQL.
# Without these, the API uses a local JSON file store seeded from the SQL dump.

PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Option A — connection string
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME

# Option B — discrete fields (Hostinger / PlanetScale / Railway / Aiven)
# DB_HOST=your-host
# DB_PORT=3306
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_NAME=u663771390_cert
# DB_SSL=true
# DB_CONNECTION_LIMIT=5
