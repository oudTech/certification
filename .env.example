# Local API
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Supabase Postgres (recommended for Vercel)
# Project Settings → Database → Connection string → URI
# Use the **Transaction pooler** (port 6543) for serverless / Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Or:
# SUPABASE_DB_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional discrete fields (alternative to DATABASE_URL)
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.XXXX
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=postgres

# SSL is on by default for hosted Postgres. Set to false only for local Postgres.
# DB_SSL=true
# DB_CONNECTION_LIMIT=3
